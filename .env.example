# THE SHIVA - Environment Variables
# Copy this file to .env and fill in the values

# Server
NODE_ENV=development
PORT=3000

# MySQL Database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=the_shiva

# Redis (optional, for caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Session
SESSION_SECRET=your_session_secret_at_least_32_characters_long
SESSION_COOKIE_NAME=shiva_session_id
SESSION_TTL_SECONDS=604800

# Google OAuth (for student sign-in)
# Create at: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=927807205305-b9b8e6v0r1v2k5f5c0q6k8d3p4n7m8o0.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OTP Provider (optional - uses console mock if not set)
# OTP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Razorpay (for payments)
# Create at: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Support Email
SUPPORT_EMAIL=support@theshiva.in

# Admin Provision (development only)
ADMIN_PROVISION_EMAIL=admin@theshiva.in
ADMIN_PROVISION_PASSWORD=YourSecurePassword123!
ADMIN_PROVISION_NAME=Administrator
